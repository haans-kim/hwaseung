"""
전사 적정인력 산정 Dashboard API (R&A, tonggibon)
"""
from fastapi import APIRouter, HTTPException, Query, Body
from fastapi.responses import JSONResponse
from typing import Dict, Any, Optional
from pydantic import BaseModel

from app.services import get_company_wide_dashboard_service

router = APIRouter(
    prefix="/company-wide/dashboard",
    tags=["company-wide-dashboard"],
    responses={404: {"description": "Not found"}},
)

class SimulateRequest(BaseModel):
    organization: str
    variables: Dict[str, float]

@router.get("/prediction")
async def get_prediction(
    organization: str = Query(..., description="Organization: 'R&A' or 'tonggibon'")
) -> Dict[str, Any]:
    """
    2026년 적정인력 예측

    Args:
        organization: 'R&A' or 'tonggibon'

    Returns:
        예측 결과
    """
    if organization not in ['R&A', 'tonggibon']:
        raise HTTPException(
            status_code=400,
            detail="organization must be 'R&A' or 'tonggibon'"
        )

    try:
        result = company_wide_dashboard_service.predict_2026(organization)
        return result

    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Prediction failed: {str(e)}")

@router.get("/importance")
async def get_feature_importance(
    organization: str = Query(..., description="Organization: 'R&A' or 'tonggibon'"),
    top_n: int = Query(10, description="Number of top features to return")
) -> Dict[str, Any]:
    """
    Feature Importance (Permutation)

    Args:
        organization: 'R&A' or 'tonggibon'
        top_n: 상위 N개 feature

    Returns:
        Feature importance 리스트
    """
    if organization not in ['R&A', 'tonggibon']:
        raise HTTPException(
            status_code=400,
            detail="organization must be 'R&A' or 'tonggibon'"
        )

    try:
        features = company_wide_dashboard_service.get_feature_importance(organization, top_n)
        return {
            'organization': organization,
            'features': features,
            'count': len(features)
        }

    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Importance calculation failed: {str(e)}")

@router.post("/simulate")
async def simulate_scenario(request: SimulateRequest) -> Dict[str, Any]:
    """
    변수 조정 시뮬레이션

    Args:
        organization: 'R&A' or 'tonggibon'
        variables: 조정할 변수 딕셔너리

    Returns:
        시뮬레이션 결과
    """
    if request.organization not in ['R&A', 'tonggibon']:
        raise HTTPException(
            status_code=400,
            detail="organization must be 'R&A' or 'tonggibon'"
        )

    try:
        result = company_wide_dashboard_service.simulate_scenario(
            organization=request.organization,
            variables=request.variables
        )
        return result

    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Simulation failed: {str(e)}")

@router.get("/trend")
async def get_trend_data(
    organization: str = Query(..., description="Organization: 'R&A' or 'tonggibon'")
) -> Dict[str, Any]:
    """
    트렌드 데이터 (과거 + 예측)

    Args:
        organization: 'R&A' or 'tonggibon'

    Returns:
        트렌드 데이터
    """
    if organization not in ['R&A', 'tonggibon']:
        raise HTTPException(
            status_code=400,
            detail="organization must be 'R&A' or 'tonggibon'"
        )

    try:
        result = company_wide_dashboard_service.get_trend_data(organization)
        return result

    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Trend data generation failed: {str(e)}")

@router.get("/variable-ranges")
async def get_variable_ranges(
    organization: str = Query(..., description="Organization: 'R&A' or 'tonggibon'")
) -> Dict[str, Any]:
    """
    변수별 조정 범위

    Args:
        organization: 'R&A' or 'tonggibon'

    Returns:
        변수 범위 딕셔너리
    """
    if organization not in ['R&A', 'tonggibon']:
        raise HTTPException(
            status_code=400,
            detail="organization must be 'R&A' or 'tonggibon'"
        )

    try:
        ranges = company_wide_dashboard_service.get_variable_ranges(organization)
        return {
            'organization': organization,
            'ranges': ranges
        }

    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Variable ranges calculation failed: {str(e)}")
